# Blueprint Vision - Environment Variables
# HANDSOME CLAUDE BUILD 🎩

# ============================================
# LLM PROVIDER (for prompt enrichment)
# ============================================
# Using OpenRouter for flexibility - can use Claude, GPT-4, etc.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for prompt enrichment
# Recommended: anthropic/claude-sonnet-4-20250514 (best quality/cost balance)
# Alternatives: openai/gpt-4o, google/gemini-pro-1.5, anthropic/claude-3-opus
ENRICHMENT_MODEL=anthropic/claude-sonnet-4-20250514

# ============================================
# BLUEPRINT MCP (for image generation)
# ============================================
# Option 1: Arcade SSE endpoint
BLUEPRINT_MCP_URL=https://your-arcade-instance.arcade.dev/sse

# Option 2: Direct Blueprint API (if available)
# BLUEPRINT_API_KEY=

# ============================================
# APP CONFIG
# ============================================
APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=

# ============================================
# OPTIONAL: Development/Debug
# ============================================
# NODE_ENV=development
# DEBUG=true
