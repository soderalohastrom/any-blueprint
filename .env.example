# Blueprint Vision - Environment Variables

# LLM Provider (for prompt enrichment)
# Choose one: openai, anthropic, cloudflare
LLM_PROVIDER=anthropic

# API Keys (use the one matching your provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Blueprint MCP (via Arcade)
# SSE endpoint for the hosted Blueprint MCP
BLUEPRINT_MCP_URL=https://your-arcade-instance.arcade.dev/sse

# Optional: App URL for callbacks
APP_URL=http://localhost:8081
